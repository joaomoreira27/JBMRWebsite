RewriteEngine On
# Uma só versão do site: www.jbmr.pt redireciona para jbmr.pt (canónico)
RewriteCond %{HTTP_HOST} ^www\.jbmr\.pt$ [NC]
RewriteRule ^(.*)$ https://jbmr.pt/$1 [L,R=301]
RewriteCond %{ENV:HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# Sem listagem de pastas
Options -Indexes

# Compressão (se o alojamento suportar mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Cache do browser para ficheiros estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# Cabeçalhos de segurança básicos
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----- Segurança -----
# Ficheiros e pastas internos nunca são servidos (repositório, notas, configuração)
RewriteRule ^\.(?!well-known/) - [F,L]
RewriteRule ^(docs|src|scripts|\.github)/ - [F,L]
# Ficheiros de configuração, notas e backups nunca são servidos
RewriteRule \.(md|json|yml|yaml|lock|bak|old|log|sql|ini|env)$ - [F,L]
# Só os métodos necessários (bloqueia TRACE, PUT, DELETE, etc.)
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$ [NC]
RewriteRule .* - [F,L]

<IfModule mod_headers.c>
    # Política de conteúdo: só carrega recursos deste domínio, do Web3Forms (formulários) e do Google Maps (mapa)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; frame-src https://www.google.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Activar só depois de confirmar que https://jbmr.pt funciona (bloqueia HTTP durante meses):
    # Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>
